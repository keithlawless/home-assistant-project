CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# A new image must prove itself (reach Taco) or the bootloader goes back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The speech front end (ESP-SR AFE) needs PSRAM: the board's ESP32-S3R8 has
# 8 MB of octal PSRAM. Larger caches are what ESP-SR recommends.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# ESP-SR's ESP32-S3 libraries are prebuilt against newlib. IDF 6 defaults to
# picolibc, which only partly emulates newlib, and with picolibc the image
# crashed at boot (it rolled back).
CONFIG_LIBC_NEWLIB=y
# Music streams to the speaker at 48 kHz (96 KB/s) down the same socket as
# the control lines. The default 5.7 KB window is only 30 ms of that.
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
